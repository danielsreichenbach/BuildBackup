{
  // GitHub Flavored Markdown (GFM) configuration
  // Reference: https://docs.github.com/en/get-started/writing-on-github/getting-started-with-writing-and-formatting-on-github/basic-writing-and-formatting-syntax

  "default": true,
  "MD003": {
    "style": "atx"
  },
  "MD004": {
    "style": "dash"
  },
  "MD007": {
    "indent": 2
  },
  "MD013": {
    "line_length": 100,
    "code_blocks": false,
    "tables": false,
    "headings": false,
    "strict": false
  },
  "MD024": {
    "siblings_only": true
  },
  "MD029": {
    "style": "ordered"
  },
  "MD033": {
    // Allow GFM-supported HTML elements
    "allowed_elements": [
      "br",
      "details",
      "div",
      "img",
      "kbd",
      "picture",
      "source",
      "sub",
      "summary",
      "sup"
    ]
  },
  "MD035": {
    "style": "---"
  },
  "MD040": {
    "allowed_languages": [
      "bash",
      "c",
      "cmake",
      "console",
      "cpp",
      "csharp",
      "diff",
      "dockerfile",
      "ebnf",
      "glsl",
      "hcl",
      "json",
      "ldif",
      "lua",
      "markdown",
      "mermaid",
      "pgsql",
      "powershell",
      "python",
      "rust",
      "shell",
      "sql",
      "text",
      "toml",
      "typescript",
      "wgsl",
      "xml",
      "yaml"
    ],
    "language_only": false
  },
  "MD046": {
    "style": "fenced"
  },
  "MD048": {
    "style": "backtick"
  },
  "MD060": false
}
